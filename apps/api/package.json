{
  "name": "@stablesave/api",
  "version": "0.1.0",
  "private": true,
  "description": "StableSave HTTP API: opportunities, vault strategies and estimates.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
