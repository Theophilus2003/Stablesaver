    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "esbuild": "^0.28.2"
  }
