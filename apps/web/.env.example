# Where market data comes from:
#   live (default) — DefiLlama's public yields API (yields.llama.fi + api.llama.fi), no key needed
#   demo            — illustrative fixtures, labelled "Demo data" everywhere (works offline)
STABLESAVE_DATA_MODE=live
# Optional: route DefiLlama requests through a proxy or mirror.
# STABLESAVE_DEFILLAMA_YIELDS_URL=https://yields.llama.fi
# STABLESAVE_DEFILLAMA_API_URL=https://api.llama.fi

# Optional: read market data from apps/api instead of in-process adapters.
# STABLESAVE_API_URL=http://localhost:4000

# Solana cluster for wallet + vault: devnet | mainnet-beta | localnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Set both once the vault program is deployed; until then the vault runs as a simulated preview.
# NEXT_PUBLIC_STABLESAVE_VAULT_PROGRAM_ID=FNeatGcWmVKVZq5BuXMQ2aaoAxjbfms6GzenerUHxWBj
# NEXT_PUBLIC_STABLESAVE_VAULT_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional: RPC for "Find idle money" (reads USDC/USDT balances on Solana mainnet, read-only).
# The public endpoint is rate-limited; a free key from any RPC provider is more reliable.
# SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: absolute site URL for share-card previews. On Vercel the production URL is used automatically.
# NEXT_PUBLIC_SITE_URL=https://stablesaver-web.vercel.app
