{
  "name": "@stablesave/client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the StableSave vault program, generated with Codama from the Anchor IDL.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts",
    "./web3js": "./src/web3js.ts"
  },
  "scripts": {
    "generate": "node ../../scripts/generate-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "init-vaults": "tsx scripts/initialize-vaults.ts",
    "devnet": "tsx scripts/devnet.ts"
  },
  "dependencies": {
    "@solana/kit": "^8.4.0",
    "@solana/program-client-core": "^8.4.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.99.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
